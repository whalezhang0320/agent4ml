# Agent4ML 环境变量配置模板
# 复制本文件为 .env 并填入真实 API key
# .env 文件已被 .gitignore 忽略，不会提交到 git

# ─────────────────────────────────────────────────────────────
# LLM Provider API Keys
# 至少配置一个 provider 的 API Key。DeepSeek 为默认 provider 且作为降级链尾兜底。
# 每个 provider 支持 {NAME}_ENABLED=false 单独禁用、{NAME}_MODEL 覆盖默认模型。
# ─────────────────────────────────────────────────────────────

# DeepSeek (默认 provider，降级兜底)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4.1-mini

# Qwen / 阿里通义（OpenAI 兼容）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-plus

# Anthropic Claude（需安装：pip install langchain-anthropic）
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Google Gemini（需安装：pip install langchain-google-genai）
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_MODEL=gemini-2.0-flash

# Moonshot / Kimi（OpenAI 兼容）
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# MOONSHOT_MODEL=moonshot-v1-128k

# OpenRouter — 聚合平台（OpenAI 兼容，可访问多家模型）
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=anthropic/claude-sonnet-4

# xAI Grok（OpenAI 兼容）
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-3

# Zhipu GLM / 智谱（OpenAI 兼容）
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ZHIPU_MODEL=glm-4-plus

# NVIDIA NIM（OpenAI 兼容）
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Ollama — 本地运行（需安装：pip install langchain-ollama；无需 API key）
# OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1


# ─────────────────────────────────────────────────────────────
# Sandbox 配置（懒加载：首次调用沙箱工具时才启动容器）
# ─────────────────────────────────────────────────────────────

# 启用沙箱：留空=禁用；填 provider 路径=启用
# Local 沙箱（本机进程，无容器隔离）：
#   agent4ml.backend.agents.sandbox.local.local_sandbox_provider:LocalSandboxProvider
# Docker 沙箱（容器隔离，需 docker daemon）：
#   agent4ml.backend.agents.sandbox.docker.docker_sandbox_provider:DockerSandboxProvider
AGENT4ML_SANDBOX_USE=

# Local 沙箱是否允许 bash 工具（默认 true；设 false 可关闭命令注入风险）
AGENT4ML_SANDBOX_ALLOW_HOST_BASH=true

# Docker 镜像（仅 Docker 沙箱模式生效）
# 默认 all-in-one-sandbox:latest（deer-flow 同款 AIO 镜像）
# 首次使用需先拉取：docker pull all-in-one-sandbox:latest
# 安全建议（S12）：浮动 tag 有供应链风险，生产环境建议 pin digest：
#   1. docker inspect --format='{{index .RepoDigests 0}}' all-in-one-sandbox:latest
#   2. 将结果填入下方：AGENT4ML_SANDBOX_IMAGE=all-in-one-sandbox@sha256:<digest>
AGENT4ML_SANDBOX_IMAGE=all-in-one-sandbox:latest

# 沙箱容器起始端口（端口被占用时自动递增）
AGENT4ML_SANDBOX_PORT=18000

# Docker 命令执行环境（仅 Docker 沙箱模式生效）
# local  = 项目与 docker daemon 同 OS（Linux/Mac 本机、DooD 容器内）
# wsl   = 项目跑在 Windows、docker daemon 在 WSL2 内
AGENT4ML_SANDBOX_EXECUTOR=local

# WSL 执行环境配置（executor=wsl 时生效，local 时忽略）
# wsl_distro: WSL 发行版名（默认 Ubuntu）
AGENT4ML_SANDBOX_WSL_DISTRO=Ubuntu
# wsl_user: WSL 内执行用户（留空=默认用户；root 需用户在 docker 组）
AGENT4ML_SANDBOX_WSL_USER=

# 容器名前缀（用于跨进程发现，确定性命名 agent4ml-sandbox-{sandbox_id}）
AGENT4ML_SANDBOX_CONTAINER_PREFIX=agent4ml-sandbox

# 空闲销毁超时秒（沙箱空闲多久后自动销毁，0=永不销毁）
AGENT4ML_SANDBOX_IDLE_TIMEOUT=600

# 预热池大小（warm_pool 容量，0=不预热）
AGENT4ML_SANDBOX_REPLICAS=3


# ─────────────────────────────────────────────────────────────
# MCP 管理模块配置
# ─────────────────────────────────────────────────────────────

# MCP 总开关（false=不加载 MCP 工具，agent 仅用 builtin/sandbox 工具）
AGENT4ML_MCP_ENABLED=false

# MCP server 配置文件路径（相对项目根，缺省 .agent4ml/mcp_servers.yaml）
AGENT4ML_MCP_CONFIG_PATH=.agent4ml/mcp_servers.yaml

# 核心工具列表（启动时必加载，逗号分隔；非核心工具走 deferred 加载）
# 缺省值与 mcp_servers.yaml 的 core_tools 字段一致
AGENT4ML_MCP_CORE_TOOLS=web_search,browse_page


# ─────────────────────────────────────────────────────────────
# Memory 配置（长期记忆 L4 召回 + L5 自动沉淀）
# ─────────────────────────────────────────────────────────────

# 启用记忆：留空=禁用；default=默认策略（Markdown + BM25）
AGENT4ML_MEMORY_USE=

# Markdown 持久化根目录（truth source）
AGENT4ML_MEMORY_STORAGE_PATH=.agent4ml/memory

# before_model 召回开关
AGENT4ML_MEMORY_ENABLE_RECALL=true

# after_model 实时抽取开关（默认关，走 L5 worker 自动沉淀）
AGENT4ML_MEMORY_ENABLE_EXTRACT=false

# 召回注入 token 预算上限
AGENT4ML_MEMORY_TOKEN_BUDGET=2000

# Phase 2 自动沉淀（L5 worker 每 N 轮触发抽取 + consolidate）
AGENT4ML_MEMORY_PHASE2_ENABLED=false
AGENT4ML_MEMORY_PHASE2_TURNS=10


# ─────────────────────────────────────────────────────────────
# MultiAgent 配置（specialist 委派 + L2 演化 + L3 评估）
# ─────────────────────────────────────────────────────────────

# MultiAgent 总开关（默认 true）
AGENT4ML_MULTIAGENT_ENABLED=true

# 启用的 specialist 列表（逗号分隔）
AGENT4ML_MULTIAGENT_SPECIALISTS=pi,codex,claude,subagent

# 自动批准 specialist 调用
AGENT4ML_MULTIAGENT_AUTO_APPROVE=true

# Pi specialist 配置（需填入凭证才能启用 pi）
# AGENT4ML_MULTIAGENT_PI_PROVIDER=deepseek
# AGENT4ML_MULTIAGENT_PI_API_KEY=
# AGENT4ML_MULTIAGENT_PI_MODEL=deepseek-v4-flash
AGENT4ML_MULTIAGENT_PI_THINKING=medium

# L2 演化层（specialist 自演化，数据驱动触发）
AGENT4ML_MULTIAGENT_L2_ENABLED=false

# L3 评估层（specialist 质量评估，数据驱动触发）
AGENT4ML_MULTIAGENT_L3_ENABLED=false


# ─────────────────────────────────────────────────────────────
# Skill 模块配置
# ─────────────────────────────────────────────────────────────

# Skill 模块总开关
AGENT4ML_SKILL_ENABLED=false

# Skill 自进化（Layer 2a）
AGENT4ML_SKILL_EVOLVE_ENABLED=false

# Skill 评估（Layer 3）
AGENT4ML_SKILL_EVAL_ENABLED=false

# Skill Hub
AGENT4ML_SKILL_HUB_ENABLED=true
AGENT4ML_SKILL_HUB_QUARANTINE=true
AGENT4ML_SKILL_HUB_AUDIT=true


# ─────────────────────────────────────────────────────────────
# ML 长任务服务（FastAPI + Redis Streams + SSE）
# ─────────────────────────────────────────────────────────────

# Redis 仅需本机可访问；不要把无认证 Redis 暴露到公网
AGENT4ML_ML_REDIS_URL=redis://127.0.0.1:6379/0
AGENT4ML_ML_REDIS_NAMESPACE=agent4ml:ml

# 任务运行记录目录，以及 API 允许作为任务 cwd 的根目录
AGENT4ML_ML_WORK_ROOT=.agent4ml/ml-tasks
AGENT4ML_ML_ALLOWED_ROOT=.

# API 默认只监听本机；对外部署时应在反向代理层增加鉴权
AGENT4ML_ML_API_HOST=127.0.0.1
AGENT4ML_ML_API_PORT=8000
AGENT4ML_ML_SSE_HEARTBEAT_SECONDS=15
